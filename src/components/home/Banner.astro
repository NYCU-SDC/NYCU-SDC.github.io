---
import GroupLight from "@/assets/home/group.webp"; // 亮色模式背景圖
import GroupDark from "@/assets/home/group.webp"; // 您可以替換為暗色模式的圖片
---

<section>
	<div class="background-light"></div>
	<div class="background-dark"></div>
	<div class="container">
		<p>在這裡你可以</p>
		<ul>
			<li class="first">學習基礎軟體工程</li>
			<li class="first">專案管理技巧</li>
			<li>伺服器管理與架設網站能力</li>
			<li>擁有自己的課外專案經驗</li>
			<li>學到資工系不會教的實用技能</li>
			<li>修課 & 實習經驗交流分享</li>
			<li>認識一群很棒的人</li>
		</ul>
	</div>
</section>
<style
	define:vars={{
		"light-image-url": `url("${GroupLight.src}")`,
		"dark-image-url": `url("${GroupDark.src}")`
	}}
>
	section {
		position: relative;
		margin: 0 auto;
		padding: 5rem 2rem;
		overflow: hidden;
	}

	.background-light,
	.background-dark {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		transition: opacity 0.3s cubic-bezier(0.32, 0.1, 0.05, 0.96);
	}

	.background-light {
		background-image: linear-gradient(#fff, #ffffffa2 30%, #ffffffa2 70%, #fff), var(--light-image-url);
		opacity: 1;
	}

	.background-dark {
		background-image: linear-gradient(#2e3440, #2e3440a2 30%, #2e3440a2 70%, #2e3440), var(--dark-image-url);
		opacity: 0;
	}

	:global(.dark) .background-light {
		opacity: 0;
	}

	:global(.dark) .background-dark {
		opacity: 1;
	}

	.container {
		position: relative;
		z-index: 1;
		max-width: 600px;
		margin: auto;
	}

	p {
		margin-bottom: 1.5rem;
		font-size: 1.4rem;
	}

	ul {
		list-style: none;
	}

	li {
		font-size: 1.75rem;
		font-weight: 700;
		color: rgba(67, 76, 94, 1);
		padding: 0.5rem 0.75rem;
		background-color: var(--nord17);
		margin-bottom: 1rem;
		width: fit-content;
	}

	li.first {
		display: inline-block;
		margin-right: 0.75rem;
	}
</style>
