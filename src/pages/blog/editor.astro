---
import Layout from "@/layouts/Layout.astro";
import BlogEditor from "@/components/editor/BlogEditor";
---
<Layout hideNav={true}>
	<section>
		<BlogEditor client:load />
	</section>
    <style>
        body {
            background-color: var(--nord0);
            color: var(--nord6);
        }
        section {
            display: flex;
            padding: 2rem 1rem;
            justify-content: center;
            gap: 2rem;
            height: 100dvh;
        }
    </style>
</Layout>
